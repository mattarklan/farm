{
  "tables": {
    "raw_telemetry": {
      "columns": [
        ["ts", "INTEGER"],
        ["device_id", "TEXT"],
        ["type", "TEXT"],
        ["metric", "TEXT"],
        ["value", "REAL"]
      ]
    },
    "latest_values": {
      "columns": [
        ["device_id", "TEXT PRIMARY KEY"],
        ["type", "TEXT"],
        ["metric", "TEXT"],
        ["value", "REAL"],
        ["ts", "INTEGER"]
      ]
    },
    "hourly_summary": {
      "columns": [
        ["hour", "INTEGER"],
        ["device_id", "TEXT"],
        ["metric", "TEXT"],
        ["min", "REAL"],
        ["max", "REAL"],
        ["avg", "REAL"],
        ["count", "INTEGER"]
      ],
      "table_constraints": [
        "PRIMARY KEY (hour, device_id, metric)"
      ]
    }
  }
}